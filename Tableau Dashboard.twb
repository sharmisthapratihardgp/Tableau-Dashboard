      <aliases enabled='yes' />
      <column caption='Top N Filter' datatype='string' name='[Calculation_1508424409664204801]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK(SUM([Calculation_1603562951391064065])) &lt;= [Parameters].[Country Parameter] THEN &quot;1&quot; ELSE &quot;0&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Weekday order' datatype='integer' name='[Calculation_1603562951390621696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE DATENAME(&apos;weekday&apos;, [InvoiceDate])&#13;&#10;    WHEN &quot;Monday&quot; THEN 1&#13;&#10;    WHEN &quot;Tuesday&quot; THEN 2&#13;&#10;    WHEN &quot;Wednesday&quot; THEN 3&#13;&#10;    WHEN &quot;Thursday&quot; THEN 4&#13;&#10;    WHEN &quot;Friday&quot; THEN 5&#13;&#10;    WHEN &quot;Saturday&quot; THEN 6&#13;&#10;    WHEN &quot;Sunday&quot; THEN 7&#13;&#10;END' />
      </column>
      <column caption='Total Sales' datatype='real' name='[Calculation_1603562951391064065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1603562951423766539] * [UnitPrice]' />
      </column>
      <column caption='Total Customers' datatype='integer' name='[Calculation_1603562951391461378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : COUNTD([CustomerID]) }' />
      </column>
      <column caption='Negative Quantity' datatype='integer' name='[Calculation_1603562951391674371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Quantity] &lt; 0 THEN 1 ELSE 0 END&#13;&#10;)' />
      </column>
      <column caption='Avg Order Value (AOV)' datatype='real' name='[Calculation_1603562951391854596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1603562951391064065]) / COUNTD([InvoiceNo])' />
      </column>
      <column caption='Product' datatype='string' name='[Calculation_1603562951392088069]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT([Description], 60)' />
      </column>
      <column caption='Weekday Name' datatype='string' name='[Calculation_1603562951392231430]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [InvoiceDate])' />
      </column>
      <column caption='Invoice Is Cancelled' datatype='integer' name='[Calculation_1603562951394717704]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM( IF STARTSWITH([InvoiceNo], &quot;C&quot;) THEN 1 ELSE 0 END )' />
      </column>
      <column caption='Missing Customer ID' datatype='integer' name='[Calculation_1603562951401885705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF ISNULL([CustomerID]) OR TRIM(STR([CustomerID])) = &quot;&quot; &#13;&#10;    THEN 1 &#13;&#10;    ELSE 0 &#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='New Quantity' datatype='integer' name='[Calculation_1603562951423766539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Quantity] &gt; 0 THEN [Quantity] END' />
      </column>
      <column caption='Sales Type' datatype='string' name='[Calculation_1603562951440707596]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STARTSWITH([InvoiceNo],&quot;C&quot;) THEN &quot;Cancelled&quot; ELSE &quot;Completed&quot; END' />
      </column>
      <column caption='KPI Parameter' datatype='real' name='[Calculation_358880604605591553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Total Sales Parameter] = &quot;Total Sales&quot; THEN SUM([Calculation_1603562951423766539] * [UnitPrice])&#13;&#10;ELSEIF [Parameters].[Total Sales Parameter] = &quot;New Quantity&quot; THEN SUM([Calculation_1603562951423766539])&#13;&#10;ELSEIF [Parameters].[Total Sales Parameter] = &quot;Invoice No&quot; THEN COUNTD([InvoiceNo])&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Customer ID' datatype='integer' name='[CustomerID]' role='dimension' type='ordinal' />
      <column caption='Invoice No (N)' datatype='integer' datatype-customized='true' name='[Invoice No (copy)_1603562951393705991]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT([InvoiceNo])' />
      </column>
      <column caption='Invoice Date' datatype='datetime' name='[InvoiceDate]' role='dimension' type='ordinal' />
      <column caption='Invoice No' datatype='string' name='[InvoiceNo]' role='dimension' type='nominal' />
      <column caption='Stock Code' datatype='string' name='[StockCode]' role='dimension' type='nominal' />
      <column aggregation='None' caption='Total Sales (bin)' datatype='integer' name='[Total Sales (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='3' formula='[Calculation_1603562951391064065]' peg='0' size='1000' />
      </column>
      <column caption='Unit Price' datatype='real' name='[UnitPrice]' role='measure' type='quantitative' />
