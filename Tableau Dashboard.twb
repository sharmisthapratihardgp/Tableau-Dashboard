  <worksheets>
    <worksheet name='Cancelled vs completed Sales'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#b6992d' fontname='Berlin Sans FB Demi' fontsize='14' italic='true' underline='true'>Cancelled vs Completed Sales comparison</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
